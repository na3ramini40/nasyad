# Django / API — loaded from repo-root `.env/server.env`
# Never commit real production secrets.

DJANGO_SECRET_KEY=change-me-in-production
# Overridden by NASYAD_MODE when unset: debug→true, release→false
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# Phone OTP SMS (optional in DEBUG — OTP logged to console when unset).
# In release / DJANGO_DEBUG=false both must be set or OTP returns 503.
SMS_PROVIDER=
SMS_API_KEY=

# Production only:
# DATABASE_URL=postgres://...
# EMAIL_HOST_PASSWORD=...
# DJANGO_SUPERUSER_PASSWORD=...   # create your own admin; never share owner’s
