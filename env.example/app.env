# Local control plane — shared by client + server tooling.
# Copy env.example/ → .env/ and edit. Never commit `.env/`.

# debug = local SQLite, console OTP, debug APK signing OK
# release = production-like server; release APK requires android/ keystore
NASYAD_MODE=debug

# Client API base (passed as --dart-define=API_BASE_URL=…)
API_BASE_URL=http://127.0.0.1:8000

# Android applicationId / namespace. Use your own id — do not use the
# official amini.apps.nasyad unless you are the repo owner with the release key.
APP_APPLICATION_ID=com.example.nasyad

# In-app update channel (GitHub Releases). Leave empty to disable checks.
# Owner sets these to the official repo; forks use their own or leave blank.
GITHUB_OWNER=
GITHUB_REPO=

# Published version — synced into git by ./tool/env_apply.sh
APP_VERSION=1.3.0
APP_BUILD=6
